# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronally.
flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

# Enables Impeller rendering for iOS
# Set to false if you experience issues with Impeller
# https://docs.flutter.dev/perf/impeller
# use_frameworks! :linkage => :static

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  flutter_additional_ios_build_settings(target)
end

target 'RunnerTests' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['SDKROOT'] = 'iphoneos'
      config.build_settings['TREAT_MISSING_CONFIGURATIONS_WARNING'] = 'NO'
      config.build_settings['EXCLUDED_ARCHS'] = ''
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
  installer.generated_projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end
    end
  end
end